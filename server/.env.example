# Copy to server/.env and adjust.
NODE_ENV=development
PORT=5000

# Local MongoDB, or a MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/prem_housing

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Public address of the website (used for SEO tags, sitemap and WhatsApp link previews).
SITE_URL=http://localhost:5000

# Set to true when running behind Nginx / a hosting proxy that terminates HTTPS.
TRUST_PROXY=false

# Only if the React app is hosted on a DIFFERENT domain than this API (comma-separated).
CLIENT_ORIGIN=

# First admin account (created by `npm run seed`).
ADMIN_EMAIL=admin@premhousing.local
ADMIN_PASSWORD=choose-a-strong-password
